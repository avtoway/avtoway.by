# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Prisma
prisma/migrations/*/migration_lock.toml

# snapshot backups (local copies, not needed in repo)
snapshots/

# QA screenshots / audit artifacts (local)
/screenshots/

# рабочая папка для черновиков (разборы видео, тестовые генерации)
/temp/

# uploaded files
/public/uploads/
# demo photos for the sale catalog (seed data)
!/public/uploads/
!/public/uploads/sell/
/public/uploads/sell/*
!/public/uploads/sell/demo-*.jpg
!/public/uploads/rent/
/public/uploads/rent/*
!/public/uploads/rent/demo-*.jpg

# исходники картинок (в репозиторий идут только собранные webp/jpg)
/assets-src/*
!/assets-src/README.md

# env files (can opt-in for committing if needed)
.env*
!.env.example

# mcp-сервер генерации картинок
/mcp/imagegen/node_modules/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Allure report
/allure-report/
/allure-results/

# Local SQLite database
/data/
