# Ключи API для MCP-сервера генерации изображений.
# Скопируй этот файл в mcp/imagegen/.env и заполни те провайдеры, которыми пользуешься.
# Достаточно ОДНОГО ключа, чтобы всё заработало.

# FLUX (Pro / Ultra / Schnell / dev), Seedream, Recraft
# https://fal.ai/dashboard/keys
FAL_KEY=

# Pollinations — бесплатный FLUX для черновиков.
# Сейчас classic API может требовать pollen key: https://enter.pollinations.ai
# Ключ (если есть) кладётся сюда, модель: pollinations-flux
POLLINATIONS_TOKEN=

# FLUX напрямую от Black Forest Labs (альтернатива fal.ai)
# https://dashboard.bfl.ai/
BFL_API_KEY=

# Imagen 4 / Ultra / Fast — есть бесплатный лимит
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# GPT-image-1 — генерация и редактирование
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Ideogram 3.0 — текст, логотипы, вывески
# https://ideogram.ai/manage-api
IDEOGRAM_API_KEY=

# FLUX через Replicate (если уже есть аккаунт Replicate)
# https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# --- Локальный ComfyUI (ключ не нужен) ---
# COMFYUI_URL=http://127.0.0.1:8188
# COMFYUI_CHECKPOINT=sd_xl_base_1.0.safetensors
# COMFYUI_STEPS=28
# COMFYUI_CFG=7
# COMFYUI_FLUX_WORKFLOW=C:\path\to\flux-api.json

# --- Необязательные настройки ---
# Куда сохранять (по умолчанию public/images/generated)
# IMAGEGEN_OUTPUT_DIR=C:\AVTOWAY\avtoway.by\avtoway.by\public\images\generated
# Базовое разрешение (1.0 ≈ 1 МП; больше — дороже)
# IMAGEGEN_MEGAPIXELS=1.0
