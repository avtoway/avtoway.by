# YouTube Data API v3
# Получить: https://console.cloud.google.com → API → YouTube Data API v3 → Создать ключ
YOUTUBE_API_KEY=

# ID канала YouTube (из URL: youtube.com/channel/UC...)
YOUTUBE_CHANNEL_ID=

# PostgreSQL (локально через docker compose up -d)
DATABASE_URL="postgresql://avtoway:avtoway@localhost:5432/avtoway_dev"

# Секрет для подписи токенов авторизации
AUTH_SECRET="change-me-to-random-string"

# Ключ для шифрования паролей (SMTP/IMAP) в БД. Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="change-me-to-random-hex-64-chars"

# Количество видео на главной (опционально)
NEXT_PUBLIC_MAX_VIDEOS=15

# Базовый URL сайта для OG-картинок и canonical (опционально)
NEXT_PUBLIC_SITE_URL="https://avtoway.by"

# Исключать Shorts (опционально)
EXCLUDE_SHORTS=true
