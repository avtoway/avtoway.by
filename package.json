{
  "name": "avtoway",
  "version": "1.0-beta",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build.mjs",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "eslint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "test:report": "vitest run && npx allure generate ./allure-results -o ./allure-report --clean && npx allure open ./allure-report",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx scripts/seed.ts && tsx scripts/seed-landings.ts",
    "db:seed:landings": "tsx scripts/seed-landings.ts",
    "db:backup": "tsx scripts/backup-db.ts",
    "db:backfill:phones": "tsx scripts/backfill-phones.ts",
    "docs:build": "tsx scripts/generate-docs.ts",
    "docs:screenshots": "tsx scripts/capture-docs-screenshots.ts",
    "db:backup:check": "tsx scripts/backup-db.ts check",
    "monitor:check": "tsx scripts/uptime-check.ts",
    "yt:analyze": "node scripts/youtube-storyboard.mjs",
    "images:build": "node scripts/images-build.mjs",
    "images:apply": "node scripts/images-build.mjs --apply",
    "release": "npm run build"
  },
  "prisma": {
    "seed": "tsx scripts/seed.ts && tsx scripts/seed-landings.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@prisma/adapter-libsql": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "dompurify": "^3.4.17",
    "imapflow": "^1.6.5",
    "mailparser": "^3.14.5",
    "next": "^16.4.6",
    "nodemailer": "^10.6.0",
    "prisma": "^7.10.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.12",
    "allure-commandline": "^2.43.0",
    "allure-vitest": "^3.10.2",
    "docx": "^9.15.4",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "@prisma/engines@7.10.1": true,
    "prisma@7.10.1": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "sharp@0.35.5": true,
    "unrs-resolver@1.12.2": true
  }
}
