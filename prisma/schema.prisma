generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id              String           @id @default(uuid())
  login           String           @unique
  password        String
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  profile         Profile?
  roles           UserRole[]
  auditLogs       AuditLog[]
  autoPodborLeads AutoPodborLead[] @relation("AutoPodborAssignee")

  @@map("users")
}

model Profile {
  id           String   @id @default(uuid())
  userId       String   @unique @map("user_id")
  name         String   @default("")
  email        String?
  phone        String?
  photo        String?
  position     String?
  birthDate    String?  @map("birth_date")
  telegram     String?
  workSchedule String?  @default("full_time") @map("work_schedule")
  hireDate     String?  @map("hire_date")
  bio          String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  level       Int              @default(0)
  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model RolePermission {
  roleId     String @map("role_id")
  permission String
  role       Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permission])
  @@map("role_permissions")
}

model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  action    String
  entity    String
  entityId  String   @map("entity_id")
  details   String?
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
  @@map("audit_logs")
}

model Service {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  description String?
  content     String?
  photo       String?
  icon        String   @default("car")
  color       String   @default("#E74C3C")
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("services")
}

model Partner {
  id            String   @id @default(uuid())
  name          String
  photo         String?
  photos        String?
  description   String?
  phone         String?
  email         String?
  address       String?
  contactPerson String?  @map("contact_person")
  website       String?
  instagram     String?
  telegram      String?
  vk            String?
  youtube       String?
  isActive      Boolean  @default(true) @map("is_active")
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("partners")
}

model Setting {
  id    String @id @default(uuid())
  key   String @unique
  value String

  @@map("settings")
}

model Contact {
  id           String   @id @default(uuid())
  phone        String?
  email        String?
  telegram     String?
  viber        String?
  whatsapp     String?
  instagram    String?
  youtube      String?
  rutube       String?
  vk           String?
  address      String?
  workingHours String?  @map("working_hours")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("contacts")
}

model ContactRequest {
  id        String   @id @default(uuid())
  name      String
  phone     String?
  email     String?
  message   String
  status    String   @default("new")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([status])
  @@index([createdAt])
  @@map("contact_requests")
}

model SentEmail {
  id        String   @id @default(uuid())
  to        String
  subject   String
  body      String
  status    String   @default("sent")
  error     String?
  inReplyTo String?  @map("in_reply_to")
  sentAt    DateTime @default(now()) @map("sent_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([sentAt])
  @@map("sent_emails")
}

model InboxEmail {
  id         String   @id @default(uuid())
  messageId  String?  @unique @map("message_id")
  from       String
  to         String
  subject    String
  body       String
  textBody   String?  @map("text_body")
  isRead     Boolean  @default(false) @map("is_read")
  isDeleted  Boolean  @default(false) @map("is_deleted")
  receivedAt DateTime @map("received_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([receivedAt])
  @@index([isRead])
  @@map("inbox_emails")
}

model RentType {
  id        String    @id @default(uuid())
  slug      String    @unique
  name      String
  sortOrder Int       @default(0)
  cars      RentCar[]

  @@map("rent_types")
}

model CarBrand {
  id       String     @id @default(uuid())
  name     String     @unique
  slug     String     @unique
  models   CarModel[]
  rentCars RentCar[]  @relation("RentCarBrand")
  saleCars SaleCar[]  @relation("SaleCarBrand")

  @@map("car_brands")
}

model Fuel {
  id   String @id @default(uuid())
  name String @unique
  slug String @unique

  @@map("fuels")
}

model Transmission {
  id   String @id @default(uuid())
  name String @unique
  slug String @unique

  @@map("transmissions")
}

model CarModel {
  id       String    @id @default(uuid())
  brandId  String    @map("brand_id")
  brand    CarBrand  @relation(fields: [brandId], references: [id], onDelete: Cascade)
  name     String
  slug     String
  rentCars RentCar[] @relation("RentCarModel")
  saleCars SaleCar[] @relation("SaleCarModel")

  @@unique([brandId, slug])
  @@map("car_models")
}

model RentCar {
  id           String             @id @default(uuid())
  name         String
  slug         String             @unique
  brandId      String?            @map("brand_id")
  modelId      String?            @map("model_id")
  brandRel     CarBrand?          @relation("RentCarBrand", fields: [brandId], references: [id], onDelete: SetNull)
  modelRel     CarModel?          @relation("RentCarModel", fields: [modelId], references: [id], onDelete: SetNull)
  classId      String?            @map("class_id")
  classRel     CarClass?          @relation(fields: [classId], references: [id], onDelete: SetNull)
  year         Int?
  color        String?
  transmission String?
  fuel         String?
  engineVolume String?            @map("engine_volume")
  seats        Int?
  features     String?
  photos       String?
  mainPhoto    String?            @map("main_photo")
  description  String?
  priceDay     Int?               @map("price_day")
  price7Days   Int?               @map("price_7days")
  priceDayTaxi Int?               @map("price_day_taxi")
  rentTypeId   String?            @map("rent_type_id")
  rentType     RentType?          @relation(fields: [rentTypeId], references: [id])
  isActive     Boolean            @default(true) @map("is_active")
  bookedUntil  String?            @map("booked_until")
  sortOrder    Int                @default(0) @map("sort_order")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  history      RentCarHistory[]
  requests     RentRequest[]
  conditions   RentCarCondition[]

  @@map("rent_cars")
}

model RentCondition {
  id            String             @id @default(uuid())
  name          String             @unique
  slug          String             @unique
  placeholder   String?
  sortOrder     Int                @default(0) @map("sort_order")
  carConditions RentCarCondition[]

  @@map("rent_conditions")
}

model RentCarCondition {
  id          String        @id @default(uuid())
  carId       String        @map("car_id")
  conditionId String        @map("condition_id")
  value       String        @default("")
  car         RentCar       @relation(fields: [carId], references: [id], onDelete: Cascade)
  condition   RentCondition @relation(fields: [conditionId], references: [id], onDelete: Cascade)

  @@unique([carId, conditionId])
  @@index([conditionId])
  @@map("rent_car_conditions")
}

model RentPricingTier {
  id        String @id @default(uuid())
  minDays   Int    @map("min_days")
  maxDays   Int?   @map("max_days")
  discount  Int    @default(0)
  sortOrder Int    @default(0) @map("sort_order")

  @@map("rent_pricing_tiers")
}

model ComfortFeature {
  id        String @id @default(uuid())
  name      String @unique
  slug      String @unique
  sortOrder Int    @default(0) @map("sort_order")

  @@map("comfort_features")
}

model CarClass {
  id        String    @id @default(uuid())
  name      String    @unique
  slug      String    @unique
  sortOrder Int       @default(0) @map("sort_order")
  deposit   Int?      @map("deposit")
  minAge    Int?      @map("min_age")
  cars      RentCar[]

  @@map("car_classes")
}

model RentExtra {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  priceType   String   @default("perDay") @map("price_type")
  price       Int      @default(0)
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("rent_extras")
}

model RentRequest {
  id        String   @id @default(uuid())
  carId     String?  @map("car_id")
  car       RentCar? @relation(fields: [carId], references: [id], onDelete: SetNull)
  name      String
  phone     String?
  email     String?
  startDate String?  @map("start_date")
  endDate   String?  @map("end_date")
  days      Int?
  extras    String?
  total     Int?
  deposit   Int?
  status    String   @default("new")
  message   String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([status])
  @@index([createdAt])
  @@map("rent_requests")
}

model RentCarHistory {
  id          String   @id @default(uuid())
  carId       String   @map("car_id")
  car         RentCar  @relation(fields: [carId], references: [id], onDelete: Cascade)
  type        String
  description String?
  amount      Int?
  date        String
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([carId])
  @@map("rent_car_history")
}

/**
 * ─── Автоподбор (/services/inspection) ───
 */

model AutoPodborSettings {
  id                String   @id @default("main")
  isActive          Boolean  @default(true) @map("is_active")
  heroBadge         String?  @map("hero_badge")
  heroTitle         String   @map("hero_title")
  heroHighlight     String?  @map("hero_highlight")
  heroSubtitle      String?  @map("hero_subtitle")
  heroImage         String?  @map("hero_image")
  heroImageAlt      String?  @map("hero_image_alt")
  priceFrom         Int?     @map("price_from")
  ctaPrimaryLabel   String   @default("Подобрать авто") @map("cta_primary_label")
  ctaSecondaryLabel String   @default("Смотреть тарифы") @map("cta_secondary_label")
  phone             String?
  telegram          String?
  whatsapp          String?
  viber             String?
  address           String?
  workingHours      String?  @map("working_hours")
  yearsExperience   Int?     @map("years_experience")
  carsChecked       Int?     @map("cars_checked")
  citiesCount       Int?     @map("cities_count")
  guaranteeDays     Int?     @map("guarantee_days")
  avgSavings        Int?     @map("avg_savings")
  reportTime        String?  @map("report_time")
  expertName        String?  @map("expert_name")
  expertRole        String?  @map("expert_role")
  expertQuote       String?  @map("expert_quote")
  expertPhoto       String?  @map("expert_photo")
  expertFacts       String?  @map("expert_facts")
  disclaimer        String?
  seoTitle          String?  @map("seo_title")
  seoDescription    String?  @map("seo_description")
  ogImage           String?  @map("og_image")
  noindex           Boolean  @default(false)
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("autopodbor_settings")
}

model AutoPodborSection {
  id          String   @id @default(uuid())
  key         String   @unique
  badge       String?
  title       String?
  subtitle    String?
  description String?
  image       String?
  imageAlt    String?  @map("image_alt")
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isActive, sortOrder])
  @@map("autopodbor_sections")
}

model AutoPodborTariff {
  id          String   @id @default(uuid())
  slug        String   @unique
  groupName   String   @default("rb") @map("group_name")
  title       String
  subtitle    String?
  description String?
  price       Int?
  priceFrom   Boolean  @default(true) @map("price_from")
  currency    String   @default("BYN")
  unit        String?
  duration    String?
  includes    String?
  badge       String?
  icon        String   @default("check")
  image       String?
  ctaLabel    String   @default("Оставить заявку") @map("cta_label")
  isPopular   Boolean  @default(false) @map("is_popular")
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([groupName, isActive, sortOrder])
  @@map("autopodbor_tariffs")
}

model AutoPodborStep {
  id          String   @id @default(uuid())
  title       String
  description String?
  duration    String?
  icon        String   @default("check")
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("autopodbor_steps")
}

model AutoPodborFeature {
  id          String   @id @default(uuid())
  type        String   @default("advantage")
  title       String
  description String?
  icon        String   @default("shield")
  stat        String?
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([type, isActive, sortOrder])
  @@map("autopodbor_features")
}

model AutoPodborCheckItem {
  id          String   @id @default(uuid())
  category    String
  title       String
  description String?
  isCritical  Boolean  @default(false) @map("is_critical")
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([category, isActive, sortOrder])
  @@map("autopodbor_check_items")
}

model AutoPodborCase {
  id            String   @id @default(uuid())
  slug          String   @unique
  title         String
  brand         String?
  model         String?
  year          Int?
  budget        Int?
  purchasePrice Int?     @map("purchase_price")
  tradeAmount   Int?     @map("trade_amount")
  days          Int?
  city          String?
  task          String?
  found         String?
  result        String?
  photos        String?
  mainPhoto     String?  @map("main_photo")
  completedAt   String?  @map("completed_at")
  isActive      Boolean  @default(true) @map("is_active")
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([isActive, sortOrder])
  @@map("autopodbor_cases")
}

model AutoPodborReview {
  id          String   @id @default(uuid())
  name        String
  city        String?
  car         String?
  rating      Int      @default(5)
  text        String
  source      String   @default("site")
  sourceUrl   String?  @map("source_url")
  isPublished Boolean  @default(false) @map("is_published")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isPublished, sortOrder])
  @@map("autopodbor_reviews")
}

model AutoPodborFaq {
  id        String   @id @default(uuid())
  question  String
  answer    String
  category  String?
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("autopodbor_faq")
}

model AutoPodborGalleryItem {
  id        String   @id @default(uuid())
  section   String
  title     String?
  alt       String
  photo     String
  prompt    String?
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([section, isActive, sortOrder])
  @@map("autopodbor_gallery")
}

model AutoPodborCity {
  id        String  @id @default(uuid())
  name      String  @unique
  slug      String  @unique
  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")

  @@map("autopodbor_cities")
}

model AutoPodborPromo {
  id         String   @id @default(uuid())
  title      String
  subtitle   String?
  discount   String?
  validUntil String?  @map("valid_until")
  isActive   Boolean  @default(true) @map("is_active")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("autopodbor_promos")
}

model AutoPodborLead {
  id           String   @id @default(uuid())
  name         String
  phone        String?
  email        String?
  messenger    String?
  city         String?
  budgetFrom   Int?     @map("budget_from")
  budgetTo     Int?     @map("budget_to")
  brand        String?
  model        String?
  serviceSlug  String?  @map("service_slug")
  serviceTitle String?  @map("service_title")
  comment      String?
  quiz         String?
  source       String   @default("form")
  status       String   @default("new")
  priceQuoted  Int?     @map("price_quoted")
  assignedToId String?  @map("assigned_to_id")
  assignedTo   User?    @relation("AutoPodborAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  internalNote String?  @map("internal_note")
  pageUrl      String?  @map("page_url")
  utmSource    String?  @map("utm_source")
  utmMedium    String?  @map("utm_medium")
  utmCampaign  String?  @map("utm_campaign")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([serviceSlug])
  @@map("autopodbor_leads")
}

/**
 * ─── Продажа авто (/services/sell) ───
 */

model SaleCar {
  id    String @id @default(uuid())
  slug  String @unique
  title String

  brandId    String?   @map("brand_id")
  modelId    String?   @map("model_id")
  brandRel   CarBrand? @relation("SaleCarBrand", fields: [brandId], references: [id], onDelete: SetNull)
  modelRel   CarModel? @relation("SaleCarModel", fields: [modelId], references: [id], onDelete: SetNull)
  generation String?

  priceUsd      Int     @map("price_usd")
  priceByn      Int?    @map("price_byn")
  oldPriceUsd   Int?    @map("old_price_usd")
  isNegotiable  Boolean @default(true) @map("is_negotiable")
  allowExchange Boolean @default(false) @map("allow_exchange")
  allowCredit   Boolean @default(false) @map("allow_credit")

  year             Int
  mileageKm        Int     @map("mileage_km")
  bodyType         String  @map("body_type")
  transmission     String
  fuel             String
  engineVolume     Float?  @map("engine_volume")
  enginePowerHp    Int?    @map("engine_power_hp")
  driveType        String  @map("drive_type")
  color            String?
  interiorMaterial String? @map("interior_material")
  interiorColor    String? @map("interior_color")
  steering         String  @default("left")
  seats            Int?    @default(5)
  doors            Int?    @default(4)

  condition      String  @default("used")
  ownersCount    String? @map("owners_count")
  originCountry  String? @map("origin_country")
  customsCleared Boolean @default(true) @map("customs_cleared")
  vin            String?
  vinVerified    Boolean @default(false) @map("vin_verified")
  originalPaint  Boolean @default(false) @map("original_paint")
  noAccidents    Boolean @default(false) @map("no_accidents")
  serviceBook    Boolean @default(false) @map("service_book")

  isInspected    Boolean @default(true) @map("is_inspected")
  expertSummary  String? @map("expert_summary")
  bodyCheckNote  String? @map("body_check_note")
  techCheckNote  String? @map("tech_check_note")
  legalCheckNote String? @map("legal_check_note")
  diagnosticsPdf String? @map("diagnostics_pdf")

  features    String?
  customSpecs String? @map("custom_specs")
  description String?
  mainPhoto   String? @map("main_photo")
  photos      String?
  videoUrl    String? @map("video_url")

  city         String  @default("Минск")
  contactName  String? @map("contact_name")
  contactPhone String? @map("contact_phone")

  status     String  @default("available")
  isFeatured Boolean @default(false) @map("is_featured")
  isActive   Boolean @default(true) @map("is_active")
  viewsCount Int     @default(0) @map("views_count")
  sortOrder  Int     @default(0) @map("sort_order")

  seoTitle       String? @map("seo_title")
  seoDescription String? @map("seo_description")

  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  requests  SaleRequest[]

  @@index([status, isActive, sortOrder])
  @@index([brandId, modelId])
  @@index([priceUsd])
  @@index([year])
  @@map("sale_cars")
}

model SaleRequest {
  id          String   @id @default(uuid())
  type        String   @default("buy")
  carId       String?  @map("car_id")
  car         SaleCar? @relation(fields: [carId], references: [id], onDelete: SetNull)
  clientName  String   @map("client_name")
  clientPhone String   @map("client_phone")
  carInfo     String?  @map("car_info")
  offerPrice  Int?     @map("offer_price")
  comment     String?
  status      String   @default("new")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([carId])
  @@map("sale_requests")
}
