{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4.1-flash",
  "agents": {
    "explore": { "model": "opencode-go/glm-5.3-flash" },
    "general": { "model": "opencode-go/glm-5.3-flash" }
  },
  "mcp": {
    "servers": {
      "imagegen": {
        "type": "local",
        "command": ["node", "mcp/imagegen/server.mjs"],
        "cwd": ".",
        "disabled": true,
        "timeout": {
          "execution": 600000
        }
      }
    }
  }
}
